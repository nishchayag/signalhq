# next-auth@4 declares a peer range of next@"^12.2.5 || ^13 || ^14 || ^15",
# which excludes Next.js 16. It works fine functionally (verified via live
# login/session/proxy testing) — this is just a stale declared peer range in
# next-auth's package.json. Without this, a plain `npm install` (including on
# Vercel) fails with an ERESOLVE error.
legacy-peer-deps=true
